# Quant Investment Environment Variables
# Copy this file to .env and fill in your values

# API Configuration
API_HOST=0.0.0.0
API_PORT=8002
WEB_PORT=3002
DEBUG=false

# Docker Compose project name (keeps service/volume naming stable)
COMPOSE_PROJECT_NAME=quant-investment

# Shared DB (PostgreSQL via Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=quant
DB_USER=quant
DB_PASSWORD=quant

# App DB connection
# - Default: SQLite (zero-config local)
DATABASE_URL=sqlite:///data/quant.db
# - Shared Docker DB (recommended for team/common data)
# DATABASE_URL=postgresql://quant:quant@localhost:5432/quant

# CORS - allowed frontend origins (must match your frontend URL)
CORS_ORIGINS=["http://localhost:3002"]

# AI Analysis (Claude API)
ANTHROPIC_API_KEY=your-anthropic-api-key

# News APIs (optional)
FINNHUB_API_KEY=your-finnhub-api-key
MARKETAUX_API_KEY=your-marketaux-api-key

# Broker settings encryption (required for saving broker credentials from UI)
# Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BROKER_CONFIG_ENCRYPTION_KEY=

# Web Configuration
NEXT_PUBLIC_API_URL=http://localhost:8002
